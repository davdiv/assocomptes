{
  "realm": "assocomptes",
  "enabled": true,
  "sslRequired": "none",
  "clients": [
    {
      "clientId": "assocomptes",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://127.0.0.1:18080/*"],
      "webOrigins": ["http://127.0.0.1:18080"]
    }
  ],
  "roles": {
    "client": {
      "assocomptes": [
        { "name": "readPeople" },
        { "name": "writePeople" },
        { "name": "readAccountSheets" },
        { "name": "writeAccountSheets" },
        { "name": "readDeposits" },
        { "name": "writeDeposits" }
      ]
    }
  },
  "users": [
    {
      "username": "editor",
      "firstName": "Editor",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "local-e2e-password" }],
      "clientRoles": {
        "assocomptes": ["readPeople", "writePeople", "readAccountSheets", "writeAccountSheets", "readDeposits", "writeDeposits"]
      }
    },
    {
      "username": "reader",
      "firstName": "Reader",
      "lastName": "Example",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "local-e2e-password" }],
      "clientRoles": {
        "assocomptes": ["readPeople", "readAccountSheets", "readDeposits"]
      }
    }
  ]
}
